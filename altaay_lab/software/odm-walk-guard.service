# Guarded stock walk at boot (replaces the 0.2.3 image's open-duck-walk.service for this build).
# Differences from the image unit (Runtime docs/RELEASE_GUIDE.md section 4): runs
# altaay_lab/bench/walk_with_guard.py (battery and temperature guards) instead of the bare walk
# script, and Restart=no, so a guard stop is not undone 5 s later by systemd.
# Edit User= and the paths if your user is not "duck". Install: PI_SETUP.md step 11.
# Needs the Xbox pad paired and on: without it the Runtime's XBoxController raises and nothing moves.
[Unit]
Description=Open Duck Mini v2 walk with the lab battery and temperature guards
After=network.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=duck
WorkingDirectory=/home/duck/Open_Duck_Mini_Runtime/scripts
Environment=ODM_RUNTIME_DIR=/home/duck/Open_Duck_Mini_Runtime
Environment=ODM_BENCH_OUT=/home/duck/odm_bench_logs
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
# pygame wants a runtime dir; the image launcher makes /tmp/xdg-$USER (RELEASE_GUIDE.md lines 171-179)
Environment=XDG_RUNTIME_DIR=/tmp/xdg-duck
ExecStartPre=/bin/mkdir -p -m 700 /tmp/xdg-duck
ExecStartPre=/bin/sleep 10
ExecStart=/home/duck/.virtualenvs/open-duck-mini-runtime/bin/python /home/duck/open_duck_mini_v2/altaay_lab/bench/walk_with_guard.py --onnx_model_path /home/duck/BEST_WALK_ONNX_2.onnx --duck_config_path /home/duck/duck_config.json
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
