# Home-network status page. One port. Not enabled by install_pi.sh.
# The process refuses peers that are not on a home network.
[Unit]
Description=Duckie status page on the home network
ConditionPathExists=/var/lib/odm/owner.json
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
User=duck
WorkingDirectory=/home/duck/open_duck_mini_v2
Environment=PYTHONPATH=/home/duck/open_duck_mini_v2
ExecStart=/usr/bin/python3 -m altaay_lab.software.owner.run_status --state /var/lib/odm --lan --port 8080
WatchdogSec=15
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
